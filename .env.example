# Copy to .env and fill in once email is set up. If SMTP_HOST is unset,
# contact submissions are logged to stdout (nothing is sent) — safe for launch.

# Where contact form enquiries are delivered
CONTACT_TO=hello@srassociates.co

# SMTP (e.g. Google Workspace or Zoho) — leave blank until ready
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=hello@srassociates.co
